{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-whatsapp",
  "description": "Minimal IPC exposed to web.whatsapp.com (nothing but the app's own commands)",
  "windows": ["main"],
  "remote": { "urls": ["https://web.whatsapp.com/*"] },
  "permissions": [
    "allow-notify",
    "allow-window-toggle",
    "allow-favicon-updated",
    "allow-menu-toggle"
  ]
}
