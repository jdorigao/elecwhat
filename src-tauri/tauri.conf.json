{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elecwhat",
  "version": "1.16.2",
  "identifier": "fr.carru.elecwhat",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["whatsapp"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Network",
    "shortDescription": "Simple desktop WhatsApp client for Linux",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": { "../locales/*.json": "locales/" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] },
      "rpm": { "epoch": 0 }
    }
  }
}
